# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/

# ── Generated run artefacts ───────────────────────────────────────────────────
# These directories are created at runtime.  The directory itself is tracked
# via .gitkeep; the contents (suite runs, unattended run metadata) are not.
artifacts/suite_*/
artifacts/unattended/
artifacts/index.html

# IMPORTANT: artifacts/performance_baselines.json IS tracked intentionally.
# It stores rolling performance history and should travel with the repo.

# ── Scheduled Task wrapper scripts ────────────────────────────────────────────
# These are generated by start_unattended_suite.ps1 and may contain the SSH
# password.  Never commit them.
artifacts/unattended/**/task_wrapper.ps1

# ── Pytest cache ──────────────────────────────────────────────────────────────
.pytest_cache/
